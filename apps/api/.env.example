NODE_ENV=development
PORT=8787
TRUST_PROXY=0

# Telegram bot token from BotFather. Never put this in the frontend.
BOT_TOKEN=123456789:replace_me

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_at_least_48_random_characters

# Comma-separated exact frontend origins. No wildcard in production.
ALLOWED_ORIGINS=http://localhost:5173

# Browser-only local development. The server refuses this in production.
DEV_AUTH_BYPASS=true

TELEGRAM_AUTH_MAX_AGE_SECONDS=600
SESSION_TTL_SECONDS=900
